FROM debian:bookworm-slim AS worker-builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 && rm -rf /var/lib/apt/lists/*
COPY vendor-worker/p2p_relay_multi.c /tmp/p2p_relay_multi.c
RUN x86_64-w64-mingw32-gcc -O2 -s -Wall -Wextra -o /tmp/p2p_relay_multi.exe /tmp/p2p_relay_multi.c

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 P2P_BACKEND=vendor P2P_VENDOR_WORKER=/usr/local/lib/p2p_relay_multi.exe P2P_VENDOR_DLL_DIR=/vendor WINEDEBUG=-all
RUN apt-get update && apt-get install -y --no-install-recommends gosu wine wine64 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY --from=worker-builder /tmp/p2p_relay_multi.exe /usr/local/lib/p2p_relay_multi.exe
COPY docker-entrypoint.sh ./
RUN useradd --system --uid 10001 --create-home bridge \
    && mkdir -p /app/data /vendor \
    && chown -R bridge:bridge /app \
    && chmod 0755 /app/docker-entrypoint.sh
EXPOSE 8095 15540 16540
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8095/api/health')"
ENTRYPOINT ["/app/docker-entrypoint.sh"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8095"]
